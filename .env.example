# Postgres connection. Neon and Vercel Postgres both work.
# On Vercel, use the pooled connection string. Never commit a real value.
DATABASE_URL=

# Some hosts set POSTGRES_URL instead. DATABASE_URL wins when both are set.
# POSTGRES_URL=

# Sign-in for /admin. Generate the hash with `npm run hash-password`
# (the password is read from the prompt or stdin, not from a command argument).
# In the Vercel dashboard, paste the hash exactly.
# In this file, write each $ as \$. Next expands $ while loading env files.
ADMIN_EMAIL=magnus@linksforcards.com
ADMIN_PASSWORD_HASH=

# At least 16 random characters. Example: openssl rand -base64 32
SESSION_SECRET=

# Public site URL, no trailing slash. Used for canonical and hreflang links.
NEXT_PUBLIC_SITE_URL=https://linksforcards.com

# The public notes page links here.
NEXT_PUBLIC_SUBSTACK_URL=https://linksforcards.substack.com

# Optional. Sent as X-Api-Key when the private admin fetches price estimates.
POKEMON_TCG_API_KEY=

# Set only for a local Postgres that does not use TLS.
# DATABASE_SSL=disable

# Embedded local database when DATABASE_URL is empty.
# `next dev` turns this on by itself. Never set it on Vercel.
# LOCAL_DB=1
